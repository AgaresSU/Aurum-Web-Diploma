# Основные настройки
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
AURUMWEB_SITE_URL=http://127.0.0.1:8000

# База данных
# Пустое значение оставляет SQLite. Для PostgreSQL указывается строка подключения.
DJANGO_SQLITE_PATH=db.sqlite3
DATABASE_URL=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
QUICK_TELEGRAM_BOT_TOKEN=
QUICK_TELEGRAM_BOT_USERNAME=

# Robokassa
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_TEST_MODE=1

# Контакты
AURUMWEB_PUBLIC_EMAIL=aurumweb@aurumweb.ru
AURUMWEB_PUBLIC_PHONE=
AURUMWEB_SELLER_NAME=
AURUMWEB_SELLER_STATUS=Самозанятый исполнитель
AURUMWEB_SELLER_INN=
